# Browser Automation MCP Environment Configuration

# Directory to store persistent browser profiles
BROWSER_MCP_PROFILE_DIR=./profiles

# Optional: Path to custom Chromium/Chrome executable (e.g., C:\Program Files (x86)\Google\Chrome\Application\chrome.exe)
BROWSER_MCP_EXECUTABLE_PATH=

# Optional: Path directly to a specific profile directory (e.g., C:\Users\Naman\AppData\Local\Google\Chrome\User Data\Profile 8)
BROWSER_MCP_PROFILE_PATH=

# Optional: Default profile name to load when profile is omitted in launch
BROWSER_MCP_DEFAULT_PROFILE=default

# Run in headless mode (true/false). Default is false for interactive / visible mode.
BROWSER_MCP_HEADLESS=false

# Default timeout in milliseconds for navigation and element waits
BROWSER_MCP_DEFAULT_TIMEOUT=30000

# Logging level (DEBUG, INFO, WARNING, ERROR)
BROWSER_MCP_LOG_LEVEL=INFO

# Human Approval Mode:
# 'strict' (requires approval for all risky actions: public posts, replies, deletions)
# 'auto' (automatically approves actions - use with caution)
# 'prompt' (interactive approval)
BROWSER_MCP_APPROVAL_MODE=strict

# Optional comma-separated list of allowed domains. Leave empty to allow any domain.
# Example: google.com,business.google.com,accounts.google.com
BROWSER_MCP_ALLOWED_DOMAINS=

# Optional comma-separated list of blocked domains.
BROWSER_MCP_BLOCKED_DOMAINS=

# SQLite database path for approvals and audit logs
BROWSER_MCP_DB_PATH=./browser_mcp.db

# Server transport configuration (stdio or sse)
BROWSER_MCP_TRANSPORT=stdio
BROWSER_MCP_HOST=127.0.0.1
BROWSER_MCP_PORT=8000
